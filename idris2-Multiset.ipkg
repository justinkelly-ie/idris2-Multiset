package idris2-Multiset
version = 0.1.0
authors = "Justin"

depends = base, contrib, linear

sourcedir = "src"

modules = Math.Interfaces, Math.Multiset, Math.Polynumber
       , Math.IntPolynumber
       , Math.SpreadPolynumber
       , Math.Fraction, Math.FractionalEvaluator, Math.Pixel
       , Math.BoxInt
       , Math.SignedFraction, Math.Singleton.Sing
       , Math.Vexel.Vexel, Math.Vexel.Byte, Math.Vexel.Transformation, Math.Maxel, Math.LMultiset
       , Math.DepMultiset, Math.DepMaxel, Math.Vexel.DepVexel, Math.Singleton.DepSing
       , Math.OnSeq.OnMSet, Math.Singleton.Bit, Math.Singleton.Bit2, Math.Singleton.SingFraction, Math.Singleton.SBFMset
       , Math.Singleton.DepSingWeighted
